# ── IMAP — only used by fetch-sample-emails.js (study emails locally) ───────
# The n8n workflow uses Gmail OAuth2 instead — no password needed there.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=seveso@tempocasa.it
IMAP_PASSWORD=YOUR_GMAIL_APP_PASSWORD   # use a Google App Password, not your real password
IMAP_TLS=true

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ── Trello ──────────────────────────────────────────────────────────────────
# Get these from: https://trello.com/app-key
TRELLO_API_KEY=YOUR_TRELLO_API_KEY
TRELLO_TOKEN=YOUR_TRELLO_TOKEN

# Checklist IDs — replace with real IDs from Trello (open card URL + /checklist)
TRELLO_CHECKLIST_IMMOBILIARE=CHECKLIST_ID_IMMOBILIARE
TRELLO_CHECKLIST_IDEALISTA=CHECKLIST_ID_IDEALISTA
TRELLO_CHECKLIST_CASA=CHECKLIST_ID_CASA
TRELLO_CHECKLIST_ALTRO=CHECKLIST_ID_ALTRO
